# Iniettate da Vercel quando colleghi Upstash Redis dal Marketplace
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Facoltativo: cambia questo valore per ricominciare da zero senza cancellare i dati vecchi
ASTA_NAMESPACE=asta:v2

# Facoltativo: giorni di inattività dopo cui un'asta scade (default 180)
ASTA_TTL_GIORNI=180

# Facoltativo: PIN richiesto per ogni modifica (evita che estranei rilancino)
ASTA_PIN=
